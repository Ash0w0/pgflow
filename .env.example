PGFLOW_RUNTIME=supabase
NEXT_PUBLIC_PLATFORM_NAME=PGFlow
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
OPERATOR_HOSTNAME=localhost:3000

# Supabase project values. Copy the real values into .env.local only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SECRET_KEY=replace_me

# Generate a long random value for production. Never commit the real value.
AUTH_RATE_LIMIT_SECRET=replace_me

# Optional one-time operator bootstrap values. Keep empty unless bootstrapping.
BOOTSTRAP_OPERATOR_PHONE=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_OPERATOR_NAME=

# Optional WhatsApp integration values. Keep real credentials in .env.local.
WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me
