{
  "name": "pgflow-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "cross-env PGFLOW_NEXT_DIST_DIR=.next-verify next build",
    "start": "next start",
    "demo:dev": "cross-env PGFLOW_RUNTIME=demo WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "demo:build": "cross-env PGFLOW_RUNTIME=demo WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "demo:start": "cross-env PGFLOW_RUNTIME=demo WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:rehearsals": "node --experimental-strip-types --test tests/rehearsals/*.test.mjs",
    "test:full": "pnpm run build && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .next-verify --ignore-pattern .next-verify-* --ignore-pattern .next-cache-backup-* --ignore-pattern .vercel",
    "db:generate": "drizzle-kit generate",
    "operator:bootstrap": "node scripts/bootstrap-platform-operator.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:full",
    "check:demo": "pnpm run demo:build && pnpm run test"
  },
  "dependencies": {
    "@remotion/player": "^4.0.498",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "^4.0.498",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workerd-linux-64": "1.20260714.1",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "magic-string": "^0.30.19",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "vite-plugin-commonjs": "^0.10.3",
    "vite-plugin-dynamic-import": "^1.5.0",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "cookie": "^0.7.2",
    "cross-spawn": "^7.0.6",
    "ws": "^8.18.0",
    "path-to-regexp": "^6.3.0",
    "undici": "^6.21.1",
    "nanoid": "^3.3.8",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "send": "^0.19.0",
    "serve-static": "^1.16.0",
    "body-parser": "^1.20.3",
    "node-fetch": "^2.7.0",
    "@supabase/node-fetch": "^2.6.15",
    "@babel/core": "^7.29.7",
    "fast-uri": "^3.1.4",
    "js-yaml": "^4.3.0",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@5": "^5.0.8",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "optionalDependencies": {
    "@cloudflare/workerd-linux-64": "1.20260714.1",
    "@cloudflare/workerd-windows-64": "1.20260714.1"
  },
  "type": "module"
}
