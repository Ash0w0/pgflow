{
  "name": "pgflow-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "cross-env PGFLOW_NEXT_DIST_DIR=.next-verify next build",
    "start": "next start",
    "demo:dev": "cross-env PGFLOW_RUNTIME=demo WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "demo:build": "cross-env PGFLOW_RUNTIME=demo WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "demo:start": "cross-env PGFLOW_RUNTIME=demo WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/unit/*.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:full": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .next-verify --ignore-pattern .next-verify-* --ignore-pattern .next-cache-backup-*",
    "db:generate": "drizzle-kit generate",
    "operator:bootstrap": "node scripts/bootstrap-platform-operator.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:full",
    "check:demo": "npm run demo:build && npm run test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.10",
    "magic-string": "^0.30.19",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "vite-plugin-commonjs": "^0.10.3",
    "vite-plugin-dynamic-import": "^1.5.0",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "type": "module"
}
